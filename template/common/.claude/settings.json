{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git branch -D *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git worktree remove --force*)",
      "Bash(gh repo delete *)",
      "PowerShell(git push --force*)",
      "PowerShell(git branch -D *)",
      "PowerShell(git reset --hard*)"
    ],
    "ask": [
      "Bash(proj ready *--yes*)",
      "Bash(proj finish *--yes*)",
      "Bash(proj protect *--yes*)",
      "Bash(proj check *--ci*)",
      "Bash(gh pr merge *)",
      "Bash(gh workflow run *)",
      "Bash(ddc *)",
      "PowerShell(proj ready *--yes*)",
      "PowerShell(proj finish *--yes*)",
      "PowerShell(gh pr merge *)",
      "PowerShell(ddc *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "matcher": "startup|resume|compact|clear", "hooks": [{ "type": "command", "command": "proj hook session-start", "timeout": 20 }] }
    ],
    "PreCompact": [
      { "hooks": [{ "type": "command", "command": "proj hook pre-compact", "timeout": 20 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "proj hook session-end", "timeout": 10 }] }
    ]
  }
}
