{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/.ssh/**)",
      "Read(./**/*credentials*)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git push -f*)",
      "Bash(git push *+*)",
      "Bash(git push *--delete*)",
      "Bash(git push *--mirror*)",
      "Bash(git branch -D *)",
      "Bash(git branch * -D *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git clean -*f*)",
      "Bash(git worktree remove *--force*)",
      "Bash(git checkout -- .)",
      "Bash(gh repo delete *)",
      "Bash(gh api * -X DELETE*)",
      "Bash(gh api * --method DELETE*)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push *+*)",
      "PowerShell(git push *--delete*)",
      "PowerShell(git push *--mirror*)",
      "PowerShell(git branch -D *)",
      "PowerShell(git branch * -D *)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean -f*)",
      "PowerShell(git clean -*f*)",
      "PowerShell(git worktree remove *--force*)",
      "PowerShell(git checkout -- .)",
      "PowerShell(gh repo delete *)",
      "PowerShell(gh api * -X DELETE*)",
      "PowerShell(gh api * --method DELETE*)"
    ],
    "ask": [
      "Bash(proj ready *--yes*)",
      "Bash(proj finish *--yes*)",
      "Bash(proj protect *--yes*)",
      "Bash(proj check *--ci*)",
      "Bash(proj runner *--yes*)",
      "Bash(gh pr merge *)",
      "Bash(gh pr ready *)",
      "Bash(gh workflow run *)",
      "Bash(gh run rerun *)",
      "Bash(gh variable set *)",
      "Bash(gh api * -X POST*)",
      "Bash(gh api * -X PUT*)",
      "Bash(gh api * -X PATCH*)",
      "Bash(git push * main*)",
      "Bash(git push * master*)",
      "Bash(ddc *)",
      "PowerShell(proj ready *--yes*)",
      "PowerShell(proj finish *--yes*)",
      "PowerShell(proj protect *--yes*)",
      "PowerShell(proj check *--ci*)",
      "PowerShell(proj runner *--yes*)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh pr ready *)",
      "PowerShell(gh workflow run *)",
      "PowerShell(gh run rerun *)",
      "PowerShell(gh variable set *)",
      "PowerShell(gh api * -X POST*)",
      "PowerShell(gh api * -X PUT*)",
      "PowerShell(gh api * -X PATCH*)",
      "PowerShell(git push * main*)",
      "PowerShell(git push * master*)",
      "PowerShell(ddc *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "proj hook session-start",
            "timeout": 20
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "proj hook pre-compact",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "proj hook session-end",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
