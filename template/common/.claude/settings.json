{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/.ssh/**)",
      "Read(./**/*credentials*)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git push -f*)",
      "Bash(git push *+*)",
      "Bash(git push *--delete*)",
      "Bash(git push *--mirror*)",
      "Bash(git branch -D *)",
      "Bash(git branch * -D *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git clean -*f*)",
      "Bash(git worktree remove *--force*)",
      "Bash(git checkout -- .)",
      "Bash(gh repo delete *)",
      "Bash(gh api * -X DELETE*)",
      "Bash(gh api * --method DELETE*)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push *+*)",
      "PowerShell(git push *--delete*)",
      "PowerShell(git push *--mirror*)",
      "PowerShell(git branch -D *)",
      "PowerShell(git branch * -D *)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean -f*)",
      "PowerShell(git clean -*f*)",
      "PowerShell(git worktree remove *--force*)",
      "PowerShell(git checkout -- .)",
      "PowerShell(gh repo delete *)",
      "PowerShell(gh api * -X DELETE*)",
      "PowerShell(gh api * --method DELETE*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "proj hook session-start",
            "timeout": 20
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "proj hook pre-compact",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "proj hook session-end",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
